# Apache kullanıyorsan: bu dosyayı sunucuda /var/www/mcpilot/.htaccess olarak koy.
# Nginx kullanıyorsan bu dosyaya ihtiyacın yok, deploy/nginx.conf'a bak.
# AllowOverride All ayarı açık olmalı.

RewriteEngine On
RewriteBase /mcpilot/

RewriteRule ^index\.html$ - [L]

# Var olan dosya veya klasör değilse index.html'e yönlendir (client-side routing)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /mcpilot/index.html [L]

<FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|ico)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
